<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- nuget.org only. Cleared first so a machine-wide or user-level feed cannot change what this
         repository restores, and a clean clone restores with no credential at all. -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
